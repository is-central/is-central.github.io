---
// Team scoreboard as a table.
// Columns: Team name | Player 1 | Dollars | Player 2 | Dollars | Player 3 | Dollars |
//          Yan gained | Yan spent | Team Dollars | Points | P/D ratio
// Data shape: see scoreboard.example.json
const { data } = Astro.props;

const isNum = (v) => typeof v === "number" && Number.isFinite(v);
const dash = "—";

const usdWhole = new Intl.NumberFormat("en", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
const usdCents = new Intl.NumberFormat("en", { style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 2 });
const numWhole = new Intl.NumberFormat("en", { maximumFractionDigits: 0 });
const numCents = new Intl.NumberFormat("en", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// Whole amounts show no decimals ($500); fractional ones always show two ($333.33, $2,875.50).
const fmtMoney = (v) => (isNum(v) ? (Number.isInteger(v) ? usdWhole : usdCents).format(v) : dash);
const fmtYan = (v) => (isNum(v) ? numWhole.format(v) : dash);
const fmtPoints = (v) => (isNum(v) ? (Number.isInteger(v) ? numWhole : numCents).format(v) : dash);
const fmtRatio = (v) => (isNum(v) ? numCents.format(v) : dash);

// Points / Team Dollars, unless the JSON provides "ratio" itself.
const ratioOf = (e) => {
  if (isNum(e.ratio)) return e.ratio;
  if (isNum(e.points) && isNum(e.teamDollars) && e.teamDollars > 0) return e.points / e.teamDollars;
  return null;
};

// Highest points first; teams without points go last, in their original order.
function sortByPoints(entries) {
  return [...entries].sort((a, b) => {
    const aOk = isNum(a.points);
    const bOk = isNum(b.points);
    if (!aOk && !bOk) return 0;
    if (!aOk) return 1;
    if (!bOk) return -1;
    return b.points - a.points;
  });
}

// Equal points share a rank (1, 1, 3). Teams without points are unranked.
function assignRanks(entries) {
  let rank = 0;
  let prev;
  return entries.map((entry, i) => {
    if (!isNum(entry.points)) return { ...entry, rank: null };
    if (i === 0 || entry.points !== prev) rank = i + 1;
    prev = entry.points;
    return { ...entry, rank };
  });
}

const ranked = assignRanks(sortByPoints(data.entries ?? []));

const updatedDate = data.updated ? new Date(data.updated) : null;
const updatedText =
  updatedDate && !Number.isNaN(updatedDate.getTime())
    ? updatedDate.toLocaleString("en", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }) + " UTC"
    : null;
---

<div class="sb">
  {data.title && <div class="sb-caption">{data.title}</div>}

  <div class="sb-scroll">
    <table class="sb-table" aria-label={data.title ?? "Scoreboard"}>
      <thead>
        <tr>
          <th scope="col" class="c-team">Team name</th>
          <th scope="col" class="c-player">Player 1</th>
          <th scope="col" class="c-num">Dollars</th>
          <th scope="col" class="c-player">Player 2</th>
          <th scope="col" class="c-num">Dollars</th>
          <th scope="col" class="c-player">Player 3</th>
          <th scope="col" class="c-num">Dollars</th>
          <th scope="col" class="c-num">Yan gained</th>
          <th scope="col" class="c-num">Yan spent</th>
          <th scope="col" class="c-num">Team Dollars</th>
          <th scope="col" class="c-num">Points</th>
          <th scope="col" class="c-num">P/D ratio</th>
        </tr>
      </thead>
      <tbody>
        {ranked.map((entry, ti) => {
          const slots = [0, 1, 2].map((i) => entry.players?.[i]);
          return (
            <tr>
              <th scope="row" class="c-team">
                <span class="team-cell">
                  {entry.rank != null && <span class="rank">#{entry.rank}</span>}
                  <span class="team-name">
                    {entry.team}
                    {entry.videos?.map((v) => (
                      <a href={v.href} target="_blank" rel="noopener noreferrer" class="vod">▶ {v.label}</a>
                    ))}
                  </span>
                </span>
              </th>
              {slots.map((p) => (
                <>
                  <td class="c-player">
                    {p ? (
                      <span class="p-name">
                        {p.name}
                        {p.videos?.map((v) => (
                          <a href={v.href} target="_blank" rel="noopener noreferrer" class="vod vod-sm">▶ {v.label}</a>
                        ))}
                      </span>
                    ) : (
                      dash
                    )}
                  </td>
                  <td class:list={["c-num", "c-dollars", { neg: isNum(p?.dollars) && p.dollars < 0 }]}>{fmtMoney(p?.dollars)}</td>
                </>
              ))}
              <td class="c-num">{fmtYan(entry.yanGained)}</td>
              <td class="c-num">{fmtYan(entry.yanSpent)}</td>
              <td class:list={["c-num", { neg: isNum(entry.teamDollars) && entry.teamDollars < 0 }]}>{fmtMoney(entry.teamDollars)}</td>
              <td class="c-num c-points">{fmtPoints(entry.points)}</td>
              <td class="c-num">{fmtRatio(ratioOf(entry))}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {updatedText && <div class="sb-updated">Updated {updatedText}</div>}
</div>

<style>
  .sb {
    margin: 1rem 0;
    font-size: 0.875rem;
  }

  .sb-caption {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
  }

  .sb-scroll {
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-4) 35%, transparent);
    border-radius: 8px;
  }

  .sb-table {
    display: table;
    width: 100%;
    min-width: 62rem;
    margin: 0;
    border-collapse: collapse;
  }

  .sb-table th,
  .sb-table td {
    padding: 0.55rem 0.75rem;
    margin: 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 40%, transparent);
    text-align: left;
    vertical-align: middle;
    background: transparent;
  }

  .sb-table tbody tr {
    background: transparent;
    transition: background 0.12s;
  }
  .sb-table tbody tr:last-child th,
  .sb-table tbody tr:last-child td {
    border-bottom: 0;
  }

  /* header */
  .sb-table thead th {
    background: var(--sl-color-gray-6);
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-gray-4) 45%, transparent);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }

  /* numeric columns */
  .sb-table .c-num {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-2);
  }
  .sb-table .c-dollars {
    color: var(--sl-color-gray-3);
  }
  .sb-table .c-points {
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .sb-table tbody .neg {
    color: #ef4444;
  }

  /* player columns */
  .sb-table .c-player {
    color: var(--sl-color-gray-2);
  }
  .p-name {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  /* first column: rank + team, stays visible while scrolling sideways */
  .sb-table .c-team {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 11rem;
    background: var(--sl-color-bg);
    box-shadow: inset 3px 0 0 var(--accent, transparent);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .sb-table thead .c-team {
    background: var(--sl-color-gray-6);
    box-shadow: none;
    z-index: 2;
  }
  .team-cell {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .rank {
    flex-shrink: 0;
    width: 1.8rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sl-color-gray-3);
  }
  .team-name {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  /* hover (opaque mix so the sticky cell stays solid) */
  .sb-table tbody tr:hover td {
    background: color-mix(in srgb, var(--sl-color-gray-5) 25%, var(--sl-color-bg));
  }
  .sb-table tbody tr:hover th.c-team {
    background: color-mix(in srgb, var(--sl-color-gray-5) 25%, var(--sl-color-bg));
  }

  /* video links */
  .vod {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--sl-color-gray-4) 25%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-4) 50%, transparent);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.12s, color 0.12s;
  }
  .vod:hover {
    background: color-mix(in srgb, var(--sl-color-gray-3) 30%, transparent);
    color: var(--sl-color-white);
  }
  .vod-sm {
    font-size: 0.58rem;
    padding: 0.1rem 0.35rem;
  }

  .sb-updated {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    color: var(--sl-color-gray-3);
    text-align: right;
  }
</style>